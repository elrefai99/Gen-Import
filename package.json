{
  "name": "gen-import",
  "version": "2.1.11",
  "description": "Generate a TypeScript barrel file for your Express/Node project using the TypeScript compiler API",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "gen-import": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:studio && tsc",
    "build:studio": "vite build --config studio/vite.config.ts",
    "prepublishOnly": "npm run build",
    "test": "npm run build && tsx --test \"test/**/*.test.ts\"",
    "test:only": "tsx --test \"test/**/*.test.ts\""
  },
  "keywords": [
    "typescript",
    "barrel",
    "imports",
    "express",
    "codegen",
    "generator"
  ],
  "author": "@elrefai99",
  "license": "MIT",
  "dependencies": {
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "typescript": "^6.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "@xyflow/react": "^12.8.4",
    "@types/node": "^25.5.0",
    "autoprefixer": "^10.4.21",
    "lucide-react": "^0.468.0",
    "postcss": "^8.5.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "vite": "^4.5.14"
  },
  "engines": {
    "node": ">=16"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elrefai99/Gen-Import.git"
  },
  "bugs": {
    "url": "https://github.com/elrefai99/Gen-Import/issues"
  },
  "homepage": "https://github.com/elrefai99/Gen-Import#readme"
}
